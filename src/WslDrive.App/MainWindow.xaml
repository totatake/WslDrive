<Window x:Class="WslDrive.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WslDrive.App.Localization"
        Title="WslDrive - Linux Partition Mounter (WSL2)"
        Height="760"
        Width="1120"
        MinHeight="600"
        MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        Drop="Window_Drop">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2.1*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.2*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header & Admin / WSL Status -->
        <Border Grid.Row="0" Background="#1B365D" CornerRadius="8" Padding="16,12" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="WslDrive" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                        <Border x:Name="ModeBadge" Background="#2B547E" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ModeBadgeText" Text="Default: Read-Only (ro,noload)" Foreground="#CFE4FF" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="HeaderSubtitleText"
                               Text="別ドライブの Linux パーティション (ext4 / btrfs / xfs) を Windows ドライブ (L: 等) として安全にマウント"
                               Foreground="#D0DCEB" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="LanguageLabel" Text="言語:" Foreground="#D0DCEB" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0" />
                    <ComboBox x:Name="LanguageComboBox" Width="92" VerticalAlignment="Center" Margin="0,0,12,0"
                              DisplayMemberPath="Label" SelectedValuePath="Mode"
                              SelectionChanged="LanguageComboBox_SelectionChanged" />
                    <TextBlock x:Name="WslDistroLabel" Text="使用 WSL:" Foreground="#D0DCEB" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0" />
                    <ComboBox x:Name="DistroComboBox" Width="150" VerticalAlignment="Center" Margin="0,0,12,0"
                              SelectionChanged="DistroComboBox_SelectionChanged" />
                    <Border x:Name="AdminBadge" Background="#2E7D32" CornerRadius="4" Padding="10,5" VerticalAlignment="Center">
                        <TextBlock x:Name="AdminBadgeText" Text="管理者権限 (OK)" Foreground="White" FontSize="11.5" FontWeight="SemiBold" />
                    </Border>
                    <Button x:Name="RelaunchAdminButton"
                            Content="管理者として再起動"
                            Visibility="Collapsed"
                            Background="#FF9800"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Padding="10,5"
                            Margin="8,0,0,0"
                            Cursor="Hand"
                            Click="RelaunchAdminButton_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Quick Status Banner -->
        <Border x:Name="StatusBanner" Grid.Row="1" Background="#EBF3FE" BorderBrush="#B6D4FE" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="StatusBannerText"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Foreground="#084298"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Text="下のリストから Linux パーティションを選択して「選択行をマウント」を押すだけで、すぐにエクスプローラーで開けます（デフォルト: 読み取り専用 / RW 切替可）。" />
                <Button x:Name="BannerUnmountAllButton"
                        DockPanel.Dock="Right"
                        Content="すべてアンマウント"
                        Visibility="Collapsed"
                        Background="#D32F2F"
                        Foreground="White"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Padding="12,4"
                        Cursor="Hand"
                        Click="UnmountAllButton_Click" />
            </DockPanel>
        </Border>

        <!-- 3. Toolbar & Options -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
            <Button x:Name="RefreshButton"
                    Content="🔄 ディスク再スキャン"
                    FontWeight="SemiBold"
                    Padding="12,6"
                    Margin="0,0,8,0"
                    Cursor="Hand"
                    Click="RefreshButton_Click" />
            <Button x:Name="InspectImageButton"
                    Content="📂 VHDX / イメージを開く..."
                    Padding="12,6"
                    Margin="0,0,14,0"
                    Cursor="Hand"
                    Click="InspectImageButton_Click" />
            <CheckBox x:Name="OnlyLinuxCheckBox"
                      Content="Linux パーティションのみ表示"
                      IsChecked="True"
                      VerticalAlignment="Center"
                      FontSize="12.5"
                      Checked="OnlyLinuxCheckBox_Changed"
                      Unchecked="OnlyLinuxCheckBox_Changed" />
        </StackPanel>

        <!-- 4. Detected Disks & Partitions List -->
        <GroupBox x:Name="PartitionsGroupBox" Grid.Row="3" Header="① 検出されたディスク ＆ Linux パーティション一覧"
                  FontWeight="SemiBold" Padding="6" Margin="0,0,0,10" Background="White" BorderBrush="#D0D7DE">
            <DataGrid x:Name="PartitionsGrid"
                      FontWeight="Normal"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserAddRows="False"
                      RowHeight="32"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EAECEF"
                      HeadersVisibility="Column"
                      Background="White"
                      BorderThickness="0"
                      SelectionChanged="PartitionsGrid_SelectionChanged"
                      MouseDoubleClick="PartitionsGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="ColDisk" Header="ディスク" Binding="{Binding DiskDisplay}" Width="80" />
                    <DataGridTextColumn x:Name="ColModel" Header="モデル名 / ソース" Binding="{Binding Model}" Width="220" />
                    <DataGridTextColumn x:Name="ColPartition" Header="番号" Binding="{Binding PartitionDisplay}" Width="60" />
                    <DataGridTextColumn x:Name="ColFs" Header="FS種別" Binding="{Binding FileSystemDisplay}" Width="80" />
                    <DataGridTextColumn x:Name="ColLabel" Header="ラベル" Binding="{Binding LabelDisplay}" Width="140" />
                    <DataGridTextColumn x:Name="ColSize" Header="サイズ" Binding="{Binding SizeDisplay}" Width="95" />
                    <DataGridTextColumn x:Name="ColDrive" Header="割当" Binding="{Binding MountedDriveDisplay}" Width="70" />
                    <DataGridTextColumn x:Name="ColStatus" Header="状態" Binding="{Binding StatusDisplay}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- 5. Mount Settings & Primary Action Bar -->
        <Border Grid.Row="4" Background="White" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,16,2">
                        <TextBlock x:Name="DriveLetterLabel" Text="割当ドライブレター:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                        <ComboBox x:Name="DriveLetterComboBox" Width="76" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                    <CheckBox x:Name="ReadWriteCheckBox"
                              Content="読み書き可能 (RW) でマウント"
                              IsChecked="False"
                              VerticalAlignment="Center"
                              Margin="0,2,16,2"
                              ToolTip="チェックを入れると読み書き可能 (rw) でマウントします。未チェック時は安全な読み取り専用 (ro) でマウントします。"
                              Checked="ReadWriteCheckBox_Changed"
                              Unchecked="ReadWriteCheckBox_Changed" />
                    <CheckBox x:Name="NoLoadCheckBox"
                              Content="ジャーナル再生を抑止 (ro,noload)"
                              ToolTip="ext4の未クリーン終了時でもディスクへの書き込みを一切行いません（RO 時の推奨設定）"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Margin="0,2,16,2" />
                    <CheckBox x:Name="OpenExplorerCheckBox"
                              Content="マウント後にエクスプローラーで自動的に開く"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Margin="0,2,12,2" />
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MountButton"
                            Content="▶ 選択行をマウント (RO)"
                            Background="#1F6FEB"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Padding="16,7"
                            Margin="0,0,8,0"
                            Cursor="Hand"
                            Click="MountButton_Click" />
                    <Button x:Name="UnmountButton"
                            Content="⏏ 選択行をアンマウント"
                            ToolTip="{Binding Source={x:Static loc:AppStrings.Instance}, Path=UnmountSelectedToolTip, Mode=OneWay}"
                            Padding="14,7"
                            Cursor="Hand"
                            Click="UnmountButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 6. Active Mounts -->
        <GroupBox x:Name="ActiveMountsGroupBox" Grid.Row="5" Header="② 現在マウント中の Linux ドライブ (WSL2 /mnt/wsl)"
                  FontWeight="SemiBold" Padding="6" Margin="0,0,0,8" Background="White" BorderBrush="#D0D7DE">
            <DataGrid x:Name="ActiveMountsGrid"
                      FontWeight="Normal"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserAddRows="False"
                      RowHeight="32"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EAECEF"
                      HeadersVisibility="Column"
                      Background="White"
                      BorderThickness="0"
                      MouseDoubleClick="ActiveMountsGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="ColActiveDrive" Header="ドライブ" Binding="{Binding MappedDriveLetter}" Width="75" FontWeight="Bold" />
                    <DataGridTextColumn x:Name="ColActiveMode" Header="モード" Binding="{Binding AccessModeDisplay}" Width="60" FontWeight="Bold" />
                    <DataGridTextColumn x:Name="ColActiveMountName" Header="マウント名" Binding="{Binding MountName}" Width="150" />
                    <DataGridTextColumn x:Name="ColActiveFs" Header="FS" Binding="{Binding FileSystemType}" Width="75" />
                    <DataGridTextColumn x:Name="ColActiveDevice" Header="WSL デバイス" Binding="{Binding SourceDeviceInWsl}" Width="110" />
                    <DataGridTextColumn x:Name="ColActiveOptions" Header="オプション" Binding="{Binding MountOptions}" Width="150" />
                    <DataGridTextColumn x:Name="ColActiveUnc" Header="UNC パス" Binding="{Binding UncPath}" Width="*" />
                    <DataGridTemplateColumn x:Name="ColActiveActions" Header="操作" Width="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Button Content="{Binding Source={x:Static loc:AppStrings.Instance}, Path=ActiveRowOpenButton, Mode=OneWay}"
                                            Background="#2E7D32"
                                            Foreground="White"
                                            FontWeight="SemiBold"
                                            BorderThickness="0"
                                            Padding="12,3"
                                            Cursor="Hand"
                                            Click="ActiveRowOpenButton_Click" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- 7. Collapsible Activity Log -->
        <Expander x:Name="LogExpander" Grid.Row="6" Header="実行ログ・詳細メッセージ" IsExpanded="True" Background="White" BorderBrush="#D0D7DE" BorderThickness="1" Padding="4">
            <Grid Height="95">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBox x:Name="LogTextBox"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas, Yu Gothic UI"
                         FontSize="11.5"
                         Background="#FAFBFC"
                         BorderThickness="0"
                         TextWrapping="NoWrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,18,0">
                    <Button x:Name="CopyLogButton" Content="ログをコピー" Padding="8,2" FontSize="11" Margin="0,0,6,0" Click="CopyLogButton_Click" />
                    <Button x:Name="ClearLogButton" Content="クリア" Padding="8,2" FontSize="11" Click="ClearLogButton_Click" />
                </StackPanel>
            </Grid>
        </Expander>
    </Grid>
</Window>
