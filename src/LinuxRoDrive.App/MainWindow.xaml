<Window x:Class="LinuxRoDrive.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LinuxRoDrive - Read-Only Linux Partition Mounter (WSL2)"
        Height="720"
        Width="1040"
        MinHeight="560"
        MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="#F6F8FA">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.3*" />
            <RowDefinition Height="1.1*" />
        </Grid.RowDefinitions>

        <!-- Header & Admin / WSL Status -->
        <Border Grid.Row="0" Background="#1F3A5F" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Vertical">
                    <TextBlock Text="LinuxRoDrive" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Read-Only Linux (ext4 / btrfs / xfs) Partition Mounter via WSL2"
                               Foreground="#D0DCEB" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="WSL Distro:" Foreground="#D0DCEB" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="DistroComboBox" Width="160" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Border x:Name="AdminBadge" Background="#2E7D32" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock x:Name="AdminBadgeText" Text="Administrator" Foreground="White" FontSize="11.5" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Toolbar -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button x:Name="RefreshButton" Content="Refresh Disks" Padding="12,5" Margin="0,0,8,0" Click="RefreshButton_Click" />
                <Button x:Name="InspectImageButton" Content="Inspect Image / Select VHDX..." Padding="12,5" Margin="0,0,12,0" Click="InspectImageButton_Click" />
                <CheckBox x:Name="OnlyLinuxCheckBox"
                          Content="Show Only Linux Partitions"
                          IsChecked="True"
                          VerticalAlignment="Center"
                          Checked="OnlyLinuxCheckBox_Changed"
                          Unchecked="OnlyLinuxCheckBox_Changed" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Right"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Foreground="#57606A"
                       FontSize="11.5"
                       Text="Note: Closing window minimizes to System Tray" />
        </DockPanel>

        <!-- Partition List -->
        <GroupBox Grid.Row="2" Header="Detected Disks &amp; Partitions" Padding="6" Margin="0,0,0,8" Background="White">
            <DataGrid x:Name="PartitionsGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserAddRows="False"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EAECEF"
                      HeadersVisibility="Column"
                      SelectionChanged="PartitionsGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Disk" Binding="{Binding DiskDisplay}" Width="70" />
                    <DataGridTextColumn Header="Model / Source" Binding="{Binding Model}" Width="190" />
                    <DataGridTextColumn Header="Part #" Binding="{Binding PartitionDisplay}" Width="58" />
                    <DataGridTextColumn Header="FileSystem" Binding="{Binding FileSystemDisplay}" Width="90" />
                    <DataGridTextColumn Header="Volume Label" Binding="{Binding LabelDisplay}" Width="140" />
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="90" />
                    <DataGridTextColumn Header="UUID" Binding="{Binding UuidDisplay}" Width="240" />
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Mount Controls Bar -->
        <Border Grid.Row="3" Background="White" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,0,0,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Drive Letter:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0" />
                    <ComboBox x:Name="DriveLetterComboBox" Width="70" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <CheckBox x:Name="NoLoadCheckBox"
                              Content="Read-Only + No Journal Replay (ro,noload)"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0" />
                    <CheckBox x:Name="OpenExplorerCheckBox"
                              Content="Open in Explorer after mount"
                              IsChecked="True"
                              VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MountButton"
                            Content="Mount (RO)"
                            Background="#1F6FEB"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Padding="14,6"
                            Margin="0,0,8,0"
                            Click="MountButton_Click" />
                    <Button x:Name="UnmountButton"
                            Content="Unmount Selected"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            Click="UnmountButton_Click" />
                    <Button x:Name="OpenDriveButton"
                            Content="Open in Explorer"
                            Padding="12,6"
                            Click="OpenDriveButton_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Active Mounts -->
        <GroupBox Grid.Row="4" Header="Active WSL2 Read-Only Mounts" Padding="6" Margin="0,0,0,8" Background="White">
            <DataGrid x:Name="ActiveMountsGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserAddRows="False"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EAECEF"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Drive" Binding="{Binding MappedDriveLetter}" Width="70" />
                    <DataGridTextColumn Header="Mount Name" Binding="{Binding MountName}" Width="160" />
                    <DataGridTextColumn Header="FS" Binding="{Binding FileSystemType}" Width="80" />
                    <DataGridTextColumn Header="WSL Device" Binding="{Binding SourceDeviceInWsl}" Width="110" />
                    <DataGridTextColumn Header="Options" Binding="{Binding MountOptions}" Width="150" />
                    <DataGridTextColumn Header="UNC Path" Binding="{Binding UncPath}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Command / Log Output -->
        <GroupBox Grid.Row="5" Header="Activity Log" Padding="6" Background="White">
            <TextBox x:Name="LogTextBox"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="11.5"
                     Background="#FAFBFC"
                     BorderThickness="0"
                     TextWrapping="NoWrap" />
        </GroupBox>
    </Grid>
</Window>
